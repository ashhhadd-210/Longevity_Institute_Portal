# ------------------------------------------------------------------
# Institute Collaborator Portal — environment configuration
# Copy to .env and fill in values. No real credential belongs in this
# file or anywhere else in the repository. Production values live in
# the Institute's password manager vault.
# ------------------------------------------------------------------

APP_NAME="Collaborator Portal"
# local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL 16 — required; SQLite is not supported) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_dev
DB_USERNAME=postgres
DB_PASSWORD=

# --- Sessions / cache / queue ---
# Sessions and queue use the database; cache uses the database locally.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# database in all deployed environments; sync acceptable only for local debugging
QUEUE_CONNECTION=database

# --- Email (Postmark in staging/production; log locally) ---
# Local development writes mail to storage/logs — no external sends.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=portal@activelongevityinstitute.org
MAIL_FROM_NAME="${APP_NAME}"
# Staging/production only:
POSTMARK_TOKEN=
# Postmark message stream for transactional mail
POSTMARK_MESSAGE_STREAM_ID=outbound
# Shared secret appended to the Postmark webhook URL (?token=...)
POSTMARK_WEBHOOK_TOKEN=

# --- Object storage (DigitalOcean Spaces — photographs) ---
FILESYSTEM_DISK=local
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

# --- Monitoring (Sentry — staging/production only) ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
